# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=Lumenly
APP_DEBUG=true
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-strong-secret-key-in-production

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=lumenly
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=lumenly
POSTGRES_URL=postgresql+asyncpg://lumenly:CHANGE_ME_IN_PRODUCTION@localhost:5433/lumenly

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017/lumenly

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_USE_HTTPS=false

# ── LLM Providers ────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Voice ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=generate-strong-jwt-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_RS256_PRIVATE=
JWT_SECRET_RS256_PUBLIC=

# ── CORS Configuration ────────────────────────────────────────
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOW_CREDENTIALS=true
ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
ALLOW_HEADERS=Content-Type,Authorization,X-Request-ID

# ── Embedding Configuration ───────────────────────────────────
# Note: VECTOR_DIMENSION must match the expected dimension for your EMBEDDING_PROVIDER
# openai: 1536, cohere: 1024, fastembed: 384, sentence_transformers: 384
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DIMENSION=1536
DISTANCE_METRIC=Cosine

# ── Rate Limiting Configuration ────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_PREFIX=rate_limit
RATE_LIMIT_ANONYMOUS_REQUESTS=10
RATE_LIMIT_AUTHENTICATED_REQUESTS=100
RATE_LIMIT_ADMIN_REQUESTS=1000
RATE_LIMIT_FAIL_OPEN=false

# ── Frontend ─────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Docker/Infrastructure ─────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_IN_PRODUCTION
