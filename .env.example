# ── Application ──────────────────────────────────────────────
APP_ENV=development
APP_NAME=Lumenly
APP_DEBUG=true
SECRET_KEY=change-me-in-production

# ── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/lumenly

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── LLM Providers ────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Voice ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Frontend ─────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:8000
