# Lumenly Environment Configuration Example
# Copy this file to .env and fill in the required values for your environment

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
# Environment: development, staging, or production
APP_ENV=development

# Application name
APP_NAME=Lumenly

# Debug mode (should be false in staging and production)
APP_DEBUG=true

# =============================================================================
# SECURITY SECRETS (REQUIRED)
# =============================================================================
# Application secret key - REQUIRED in all environments
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-min-32-characters

# JWT secret key - REQUIRED in all environments
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here-min-32-characters

# IMPORTANT: SECRET_KEY and JWT_SECRET must be different

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT algorithm: HS256 (default) or RS256
JWT_ALGORITHM=HS256

# Access token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RS256 keys (only required if JWT_ALGORITHM=RS256)
# JWT_SECRET_RS256_PRIVATE=
# JWT_SECRET_RS256_PUBLIC=

# =============================================================================
# FRONTEND CONFIGURATION (Vite, public and non-secret)
# =============================================================================
# Base URL of the backend API used by the web frontend (apps/frontend).
# VITE_ variables are bundled into the client build - never put secrets here.
# Development default is http://localhost:8000 (see apps/frontend/README.md).
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL user
POSTGRES_USER=lumenly

# PostgreSQL password (change in production)
POSTGRES_PASSWORD=lumenly_secure_password_32chars

# PostgreSQL database name
POSTGRES_DB=lumenly

# PostgreSQL connection URL (constructed from above)
# POSTGRES_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# MongoDB connection URL
MONGODB_URL=mongodb://mongo:27017/lumenly?replicaSet=rs0

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Qdrant configuration
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# QDRANT_API_KEY= (only required for Qdrant cloud)

# =============================================================================
# LLM PROVIDER CREDENTIALS
# =============================================================================
# At least one LLM provider must be configured in production

# Groq API key (optional)
GROQ_API_KEY=

# Gemini API key (optional)
GEMINI_API_KEY=

# ElevenLabs API key (optional, for voice features)
ELEVENLABS_API_KEY=

# OpenAI API key (optional, for embeddings)
OPENAI_API_KEY=

# Cohere API key (optional, for embeddings)
COHERE_API_KEY=

# =============================================================================
# EMBEDDING CONFIGURATION
# =============================================================================
# Embedding provider: openai, cohere, fastembed, sentence_transformers
EMBEDDING_PROVIDER=openai

# Embedding model name
EMBEDDING_MODEL=text-embedding-3-small

# Vector dimension (must match embedding provider)
VECTOR_DIMENSION=1536

# Distance metric: Cosine, Euclid, Dot
DISTANCE_METRIC=Cosine

# =============================================================================
# GEMINI CONFIGURATION
# =============================================================================
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Rate limiting enabled (should be true in staging and production)
RATE_LIMIT_ENABLED=true

# Rate limit Redis prefix
RATE_LIMIT_REDIS_PREFIX=rate_limit

# Anonymous user rate limit (requests per minute)
RATE_LIMIT_ANONYMOUS_REQUESTS=10

# Authenticated user rate limit (requests per minute)
RATE_LIMIT_AUTHENTICATED_REQUESTS=100

# Admin user rate limit (requests per minute)
RATE_LIMIT_ADMIN_REQUESTS=1000

# Fail open (false = fail-closed, true = fail-open)
# Should be false in production for security
RATE_LIMIT_FAIL_OPEN=false

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Comma-separated list of allowed CORS origins.
# Do NOT use "*" here: with ALLOW_CREDENTIALS=true the application rejects
# wildcard origins at startup, and wildcard origins are rejected outright in
# production. Always list explicit origins.
# Development: http://localhost:3000,http://localhost:8000
# Production: https://yourdomain.com,https://app.yourdomain.com
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000

# Allow credentials
ALLOW_CREDENTIALS=true

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# =============================================================================
# GRAFANA CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lumenly

# =============================================================================
# ENVIRONMENT-SPECIFIC NOTES
# =============================================================================
#
# DEVELOPMENT:
# - APP_ENV=development (backend default for running locally)
# - APP_DEBUG=true for easier debugging
# - RATE_LIMIT_ENABLED can be false for convenience
# - ALLOW_ORIGINS can include localhost
# - Can use placeholder credentials for local services
#
# TEST (backend test suite, apps/backend/tests):
# - APP_ENV=test - set automatically by apps/backend/tests/conftest.py before
#   the app is imported; you do not need to configure it
# - APP_ENV=test forces the mock LLM and mock embedding providers
#   (see app/api/deps.py), so tests never call real AI providers
# - Tests still require real local services (PostgreSQL, MongoDB, Redis,
#   Qdrant) for integration coverage
# - Uses test-specific secrets in conftest.py
# - RATE_LIMIT_ENABLED=false by default in tests; rate-limiting tests
#   re-enable it selectively via the rate_limit_test pytest marker
# - CORS in tests: do NOT use "*" - the app rejects wildcard origins when
#   ALLOW_CREDENTIALS=true. Use explicit local origins such as
#   ALLOW_ORIGINS=http://localhost:3000,http://localhost:8000
#
# Note the distinction: DEVELOPMENT is for running the app locally by a
# developer (real providers if keys are configured); TEST is the pytest
# environment with deterministic mock providers.
#
# STAGING:
# - APP_ENV=staging
# - APP_DEBUG=false (mandatory)
# - RATE_LIMIT_ENABLED=true (mandatory)
# - Use staging-specific domains in ALLOW_ORIGINS
# - Use external secrets, not repository defaults
# - All production validations apply
#
# PRODUCTION:
# - APP_ENV=production (mandatory)
# - APP_DEBUG=false (mandatory)
# - RATE_LIMIT_ENABLED=true (mandatory)
# - RATE_LIMIT_FAIL_OPEN=false (mandatory)
# - SECRET_KEY and JWT_SECRET must be external, min 32 chars, different
# - Database credentials must be external, no localhost
# - At least one LLM API key must be set
# - ALLOW_ORIGINS must be production domains (no localhost, no wildcard)
# - RS256 keys required if JWT_ALGORITHM=RS256
# - Startup will fail if any required credential is missing or invalid
#
# =============================================================================
