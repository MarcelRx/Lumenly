class TestBackgroundTaskIsolation:
    """Test background task multi-tenant isolation."""

    @pytest.mark.asyncio
    async def test_concurrent_tasks_dont_cross_tenant_boundaries(self, user_a, user_b):
        """Test that concurrent tasks for different users don't interfere."""
        import asyncio

        # Simulate concurrent document processing for both users
        async def process_user_a():
            # Mock document for user A
            return {"user_id": str(user_a.id), "status": "completed"}

        async def process_user_b():
            # Mock document for user B
            return {"user_id": str(user_b.id), "status": "completed"}

        # Run tasks concurrently
        results = await asyncio.gather(
            process_user_a(),
            process_user_b()
        )

        # Verify results are isolated
        assert results[0]["user_id"] == str(user_a.id)
        assert results[1]["user_id"] == str(user_b.id)

    @pytest.mark.asyncio
    async def test_task_retry_preserves_isolation(self, user_a, user_b):
        """Test that task retries preserve tenant isolation."""

        # Even on retry, user ownership should be validated
        # This would require testing the retry logic
        pass


