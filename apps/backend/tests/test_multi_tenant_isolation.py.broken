class TestRAGServiceIsolation:
    """Test RAG service multi-tenant isolation."""

    @pytest.mark.asyncio
    async def test_rag_service_user_isolation(self, user_a, user_b):
        """Test that RAG service isolates context per user."""
        mock_llm = AsyncMock()
        mock_vector = AsyncMock()

        rag_service = RAGService(mock_llm, mock_vector)

        # User A's query should only search User A's vectors
        mock_vector.search_vectors.return_value = [
            MagicMock(payload={"user_id": str(user_a.id), "content": "User A context"})
        ]

        await rag_service.ask_question(str(user_a.id), "test query")

        # Verify that search was called with user_a's ID
        mock_vector.search_vectors.assert_called_once()
        call_args = mock_vector.search_vectors.call_args
        assert call_args[1]["user_id"] == str(user_a.id)

    @pytest.mark.asyncio
    async def test_rag_context_filtering(self, user_a, user_b):
        """Test that RAG context is filtered by user_id."""
        mock_llm = AsyncMock()
        mock_vector = AsyncMock()

        rag_service = RAGService(mock_llm, mock_vector)

        # Mock search results - should only include user_a's data
        mock_vector.search_vectors.return_value = [
            MagicMock(payload={"user_id": str(user_a.id), "content": "User A content"}),
            MagicMock(payload={"user_id": str(user_a.id), "content": "More User A content"}),
        ]

        await rag_service.ask_question(str(user_a.id), "test query")

        # Verify that returned context is from user_a only
        call_args = mock_vector.search_vectors.call_args
        assert call_args[1]["user_id"] == str(user_a.id)


class TestCrossTenantDataLeakage:
    """Test for potential cross-tenant data leakage scenarios."""

    @pytest.mark.asyncio
    async def test_no_cross_tenant_document_leakage(self, user_a, user_b):
        """Test that documents cannot leak across tenants."""
        # Create documents for both users
        doc_a = UserDocument(
            user_id=user_a.id,
            filename="secret_a.txt",
            content="User A's secret data",
            status=DocumentStatus.PROCESSED,
        )
        doc_b = UserDocument(
            user_id=user_b.id,
            filename="secret_b.txt",
            content="User B's secret data",
            status=DocumentStatus.PROCESSED,
        )
        await doc_a.save()
        await doc_b.save()

        # User A's query should not return User B's documents
        user_a_results = await UserDocument.find(UserDocument.user_id == user_a.id).to_list()
        for doc in user_a_results:
            assert doc.user_id == user_a.id
            assert "User B's secret data" not in doc.content

        # User B's query should not return User A's documents
        user_b_results = await UserDocument.find(UserDocument.user_id == user_b.id).to_list()
        for doc in user_b_results:
            assert doc.user_id == user_b.id
            assert "User A's secret data" not in doc.content

        # Cleanup
        await UserDocument.delete(doc_a)
        await UserDocument.delete(doc_b)

    @pytest.mark.asyncio
    async def test_no_cross_tenant_vector_leakage(self, user_a, user_b):
        """Test that vectors cannot leak across tenants in Qdrant."""
        # This would require mocking Qdrant client
        # Verify that queries with user_id filter never return other users' vectors
        pass

    @pytest.mark.asyncio
    async def test_no_cross_tenant_memory_leakage(self, user_a, user_b):
