{
  "dashboard": {
    "title": "Lumenly Backend - RAG Service Overview",
    "tags": ["lumenly", "backend", "rag"],
    "timezone": "browser",
    "panels": [
      {
        "title": "RAG Response Latency (95th percentile)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rag_response_latency_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "seconds"},
          {"format": "short"}
        ]
      },
      {
        "title": "Gemini API Latency",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(gemini_api_latency_seconds_bucket[5m]))",
            "legendFormat": "95th percentile",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "s", "label": "seconds"},
          {"format": "short"}
        ]
      },
      {
        "title": "Request Rates",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(rag_response_latency_seconds_count[1m])",
            "legendFormat": "RAG Requests/sec",
            "refId": "A"
          },
          {
            "expr": "rate(gemini_requests_total[1m])",
            "legendFormat": "Gemini Requests/sec",
            "refId": "B"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "req/sec"},
          {"format": "short"}
        ]
      },
      {
        "title": "Error Rates",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(gemini_requests_failure_total[5m]) / rate(gemini_requests_total[5m]) * 100",
            "legendFormat": "Gemini Failure Rate (%)",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "percent", "label": "%"},
          {"format": "short"}
        ]
      },
      {
        "title": "Context Retrieval Success",
        "type": "stat",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rate(retrieve_context_latency_seconds_count[5m])",
            "legendFormat": "Retrieval Requests/sec",
            "refId": "A"
          }
        ]
      },
      {
        "title": "Rate Limit Status",
        "type": "gauge",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 4},
        "targets": [
          {
            "expr": "rate(rag_response_latency_seconds_count[1m])",
            "legendFormat": "Current Rate",
            "refId": "A"
          }
        ]
      }
    ],
    "time": {"from": "now-1h", "to": "now"},
    "refresh": "30s"
  },
  "overwrite": true
}